; 3D geometry for the citro3d renderer: transforms vertices and feeds the
; PICA200 fragment lighting unit (view vector + normal quaternion).

; Uniforms (PICA200: a uniform may only be the first source operand)
.fvec projection[4], modelView[4]
.fvec uvTransform    ; xy = scale, zw = offset
.fvec colorScale     ; vertex color is color * colorScale + colorBias,
.fvec colorBias      ; so (1,0) uses COLOR and (0,1) ignores it.

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.5)
.constf bytescale(0.00392156862745098, 0.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  half  myconst.wwww

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outview view
.out outnq normalquat

; Inputs
.alias inpos v0
.alias innrm v1
.alias intex v2
.alias inclr v3

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * pos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	mov outview, -r1

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; uv * scale + offset
	mov r2, intex
	mul r2.xy, uvTransform.xy, r2.xy
	add r2.xy, uvTransform.zw, r2.xy
	mov outtc0, r2

	; vertex color (bytes) -> [0,1], then the scale/bias switch.
	mul r3, bytescale.xxxx, inclr
	mul r3, colorScale, r3
	add outclr, colorBias, r3

	; Normal to view space (assumes uniform scale), normalized.
	dp3 r14.x, modelView[0], innrm
	dp3 r14.y, modelView[1], innrm
	dp3 r14.z, modelView[2], innrm
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; Quaternion rotating +Z onto the normal.
	mov r0, myconst.yxxx
	add r4, ones, r14.z
	mul r4, half, r4
	cmp zeros, ge, ge, r4.x
	rsq r4, r4.x
	mul r5, half, r14
	jmpc cmp.x, degenerate

	rcp r0.z, r4.x
	mul r0.xy, r5, r4

degenerate:
	mov outnq, r0

	end
.end
