; Shadow casters: like the scene shader's position, but the color output
; carries the light-space depth (z/w + 1, 0 = near .. 1 = far), which the
; TEV writes to the shadow map's alpha. The PICA200 lighting unit compares
; it with each receiver's texcoord0w.

.fvec projection[4], modelView[4]
.fvec posScale, posOffset ; packed positions: v0 * posScale + posOffset

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  ones myconst.yyyy

.out outpos position
.out outclr color

.alias inpos v0

.proc main
	mul r0.xyz, posScale, inpos
	add r0.xyz, posOffset, r0
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 r0.x, projection[0], r1
	dp4 r0.y, projection[1], r1
	dp4 r0.z, projection[2], r1
	dp4 r0.w, projection[3], r1
	mov outpos, r0

	rcp r2.w, r0.w
	mul r2.z, r0.z, r2.w
	add r2.z, ones, r2.z
	mov outclr, r2.zzzz

	end
.end
