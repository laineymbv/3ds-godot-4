; 2D canvas items and screen blits. Positions arrive already transformed to
; render-target pixels; one projection maps them to clip space.

.fvec projection[4]

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  ones myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1   ; 2D light texture
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2
.alias inlight v3

.proc main
	mov r0.xy, inpos.xy
	mov r0.z,  myconst.x
	mov r0.w,  ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	mov outtc1, inlight
	mul outclr, myconst.zzzz, inclr

	end
.end
